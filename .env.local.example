# ==========================================
# English Capsules LMS - Environment Variables
# Copy this file to .env.local for local dev
# ==========================================

# Firebase Client Configuration (Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# App URL (Local or Production Domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Panel Credentials & JWT Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=abir12
ADMIN_JWT_SECRET=generate_a_random_32_byte_secret_here

# SSLCommerz Payment Gateway Configuration (Optional for Live Transactions)
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_IS_LIVE=false
