# ==========================================
# Career Bridge.Studio - Environment Variables
# Copy this file to .env.local for local dev
# ==========================================

# App URL (Local or Production Domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Panel Credentials & JWT Configuration
ADMIN_USERNAME=choose_an_admin_username
ADMIN_PASSWORD=choose_a_long_unique_password
ADMIN_JWT_SECRET=generate_a_random_32_byte_secret_here

# SSLCommerz Payment Gateway Configuration (Optional for Live Transactions)
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_IS_LIVE=false

# Lesson video storage — Cloudflare R2 (see docs/video-storage.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supabase (payments, enrollments, lesson questions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
